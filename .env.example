# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Пустой ключ = провайдер пропускается (кроме keyless-провайдеров Kilo и OVHcloud — они работают и без ключа).
GROQ_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=

# Kilo AI Gateway: без ключа — бесплатные модели, 200 запросов/час на IP. Ключ необязателен.
KILO_API_KEY=
# OVHcloud AI Endpoints: без ключа — 2 запроса/мин на IP и модель; с ключом — 400/мин (тогда OVH_AI_RPM=400).
OVH_AI_API_KEY=
# OVH_AI_RPM=2

# Cloudflare Workers AI (free: 10 000 Neurons/сутки). Нужны ОБА значения, иначе провайдер пропускается.
# Токен: https://dash.cloudflare.com/profile/api-tokens (шаблон «Workers AI»), Account ID — в дашборде.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Gonka Broker. Без GONKA_API_KEY провайдер выключен. Адрес и модель можно не задавать:
# по умолчанию публичный прокси и deepseek-ai/DeepSeek-V4-Flash-0731 (контекст 400k).
# Ключ в репозиторий не кладём.
GONKA_API_KEY=
# GONKA_BASE_URL=https://proxy.gonkabroker.com/v1
# GONKA_LIMITS_PROBE_URL=
# GONKA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Google AI Gemini (gemini-2.5-pro, окно 1M). Без ключа провайдер пропускается.
GEMINI_API_KEY=

# PostgreSQL (используются и контейнером postgres, и шлюзом)
DB_NAME=gateway
DB_USER=gateway
DB_PASSWORD=gateway
DB_PORT=5432
GATEWAY_PORT=4000

# На будущее (Telegram-бот, issue #14 — отложен)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
