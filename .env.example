# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Пустой ключ = провайдер пропускается.
GROQ_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=

# PostgreSQL (используются и контейнером postgres, и шлюзом)
DB_NAME=gateway
DB_USER=gateway
DB_PASSWORD=gateway
DB_PORT=5432
GATEWAY_PORT=4000

